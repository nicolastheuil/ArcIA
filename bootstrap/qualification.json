    "lock": "builder/skills.lock.json",
    "installation_step": "install_hermes_tools_base",
    "verification_step": "verify_hermes_tools",
    "secondary_runtime_step": "install_multiuser",
    "permissions": "read_only_local_stdio",
    "tokenmaxing": "native_plugin_in_tools_job_and_both_runtime_probes"
  },
  "configuration_contracts": {
    "microsoft365": {
      "lock": "bootstrap/microsoft365.lock.json",
      "runtime_implemented": false,
      "instance_path": "instance/microsoft365.yaml",
      "validation": "scripts/microsoft365_config.py",
      "documentation": "docs/annexes/integration-microsoft365.md"
    },
    "identity": {
      "default_provider": "keycloak_local",
      "local_accounts": "permanent",
      "sso_mode": "parallel_optional_broker",
      "admin_portal_path": "/admin/users",
      "account_portal_path": "/account",
      "admin_access_script": "scripts/Show-IdentityAccess.ps1",
      "state_selection": "complete_scoped_identity_local_choice",
      "lock": "bootstrap/identity.lock.json",
      "personal_portal": "/portal/",
      "automatic_first_login": true,
      "stable_ownership": "issuer_subject_never_reassigned",
      "capacity_default": 8,
      "controller_scope": "fixed_slots_scale_and_suspend_only",
      "legacy_fixtures": "fresh_qualification_only_no_recreation_on_reconcile",
      "personal_access_script": "scripts/Open-ArcIA.ps1",
      "microsoft_egress": {
        "planning_step": "plan_identity_microsoft_egress",
        "approval_required": "server_verified_teams",
        "mode": "qualification_ipv4_dns_snapshot",
        "ports": [
          443
        ],
        "hosts": [
          "login.microsoftonline.com",
          "graph.microsoft.com"
        ],
        "automatic_dns_refresh": false,
        "plan_validity_seconds": 600,
        "automatic_deployment_enabled": false,
        "repair_action": "apply_identity_microsoft_egress_repair",
        "repair_requires": "explicit_operator_exception_for_named_plan",
        "inspection_step": "inspect_identity_microsoft_egress"
      },
      "tenant_admission": {
        "mode": "explicit_setup_microsoft_verified_tenant_mapper",
        "role": "ArcIA.User",
        "mapper_type": "oidc-hardcoded-role-idp-mapper",
        "mapper_sync_mode": "FORCE",
        "protected_policy": "identity-access-policy.dpapi",
        "admin_recovery": "existing_named_account_only_explicit_exception",
        "plan_action": "plan_identity_access_repair",
        "apply_action": "apply_identity_access_repair",
        "inspection_step": "inspect_identity_access_policy",
        "automatic_privilege_repair": false
      },
      "capacity_maximum": 32,
      "public_https": {
        "instance_option": "identity.https_egress_mode",
        "default": "disabled",
        "enabled_mode": "public_ipv4_443",
        "target": "keycloak_only",
        "protocol": "TCP",
        "port": 443,
        "destination_control": "upstream_firewall",
        "private_cluster_ranges_excluded": true,
        "installation_step": "install_identity_public_https_egress",
        "snapshot_migration": "owned_resource_version_replace_no_force",
        "approval": "explicit_operator_instance_configuration",
        "inspection_step": "inspect_identity_microsoft_egress"
      },
      "personal_cleanup": {
        "plan_action": "plan_personal_cleanup",
        "apply_action": "apply_personal_cleanup",
        "automatic_deletion": false,
        "eligible_users": "missing_subject_404_only_disabled_retained",
        "approval_required": "server_verified_teams_or_explicit_named_exception",
        "scope": "fixed_owned_slots_and_exact_csi_claims",
        "plan_validity_seconds": 600,
        "preservation": "all_remaining_bindings_and_pvcs",
        "recovery": "install_personal_portal_no_repeated_deletion"
      },
      "runtime_https_path": "node_443_and_ingress_pods_8443"
    },
    "routing": {
      "lock": "bootstrap/routing.lock.json",
      "default_router": "omniroute",
      "automatic_mode": "admin_selected_auto",
      "management_exposure": "private_lan_only",
      "management_port": 20129,
      "public_ingress": false,
      "personal_provider_role": "ArcIA.ProviderSelfService",
      "personal_providers_default": false,
      "cloud_filter_default": "presidio",
      "internal_filter_default": false,
      "cost_and_zdr_owner": "instance",
      "installation_step": "install_omniroute",
      "verification_step": "verify_omniroute",
      "inspection_step": "inspect_omniroute",
      "management_endpoint": "private_https_vip",
      "network_override": "explicit_private_firewall_boundary",
      "ip_https": {
        "enrollment_script": "scripts/Enable-RoutingIpAccess.ps1",
        "secret_optional": "routing-ip-tls.dpapi",
        "client_trust": "explicit_operator_current_user"
      }
    }
  }
