# ==============================================================================
# ArcIA — Configuration Flat .ENV (Alternative à arcia.config.yaml)
# ==============================================================================
# Copiez vers 'arcia.env' si vous préférez la syntaxe .env plutôt que YAML.

# 1. KUBERNETES [OBLIGATOIRE]
ARCIA_K8S_MODE="local"                      # 'local' ou 'remote-ssh'
ARCIA_KUBE_CONFIG=""                        # Chemin vers kubeconfig ou vide pour ~/.kube/config
ARCIA_KUBE_CONTEXT=""                       # Contexte kubeconfig ou vide
ARCIA_NAMESPACE="arcia"                     # Namespace K8s cible
ARCIA_STORAGE_CLASS=""                      # StorageClass ou vide pour classe par défaut
ARCIA_K3S_NODE="127.0.0.1"                  # Uniquement si mode 'remote-ssh'
ARCIA_K3S_USER="debian"                     # Uniquement si mode 'remote-ssh'
ARCIA_K3S_PORT="22"                         # Port SSH (défaut 22)
ARCIA_K3S_SSH_KEY=""                        # Chemin clé privée SSH (~/.ssh/id_rsa) ou vide

# 2. RESEAU, FQDN & TLS [OBLIGATOIRE]
ARCIA_PUBLIC_FQDN="assistant.example.org"   # FQDN public d'accès
ARCIA_INGRESS_CLASS="traefik"               # 'traefik' ou 'nginx'
ARCIA_TLS_MODE="letsencrypt-prod"           # 'letsencrypt-prod', 'custom-secret', 'disabled'
ARCIA_ACME_EMAIL="admin@example.org"        # Requis si letsencrypt
ARCIA_TLS_SECRET="arcia-tls-cert"           # Nom du secret TLS

# 3. PASSERELLE IA [OBLIGATOIRE]
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
LITELLM_MASTER_KEY="sk-arcia-master-key-change-me-32b"
ARCIA_DEFAULT_MODEL="simple/auto"
VLLM_INTERNAL_URL=""

# 4. HERMES AGENT & STUDIO [OBLIGATOIRE]
HERMES_ADMIN_PASSWORD="admin"
HERMES_API_SERVER_KEY="arcia-pat-change-me-secret-key-32b"
HERMES_STORAGE_SIZE="20Gi"

# 5. PRESIDIO DLP [OBLIGATOIRE]
PRESIDIO_ENABLED="true"
PRESIDIO_MASTER_KEY="arcia-presidio-master-secret-key"

# 6. OPEN-WEBUI [OBLIGATOIRE]
OPEN_WEBUI_ENABLED="true"
OPEN_WEBUI_STORAGE_SIZE="20Gi"

# 7. SSO ENTRA ID [OPTIONNEL]
ENTRA_ID_ENABLED="false"
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""
OAUTH2_PROXY_COOKIE_SECRET=""

# 8. TEAMS BOT [OPTIONNEL]
TEAMS_BOT_ENABLED="false"
TEAMS_BOT_APP_ID=""
TEAMS_BOT_APP_PASSWORD=""
TEAMS_SYSTEM_PROMPT="Tu es ArcIA, l'assistant et orchestrateur agentique d'entreprise."

# 9. MICROSOFT 365 [OPTIONNEL]
M365_ENABLED="false"


