# ==============================================================================
# ArcIA v0.7.0 — Cible agentgateway et compatibilité de migration
# ==============================================================================

# Contrat cible : docs/v0.7/contrat-applicatif.md
# La qualification ne migre pas l'instance ; le déploiement complet reste fermé
# jusqu'à recette JWT/CEL, Presidio, Hermes/A2A, fichiers et restauration.
gateway:
  implementation: agentgateway
  mode: qualification_only
# Ce fichier est le point d'entrée UNIQUE pour déployer la plateforme ArcIA sur
# N'IMPORTE QUEL cluster Kubernetes (K3s, EKS, AKS, GKE, Minikube, KinD, etc.).
#
# INSTRUCTIONS RAPIDES :
# 1. Copiez ce fichier vers 'arcia.config.yaml' (exclu de Git) :
#      cp arcia.config.yaml.example arcia.config.yaml
# 2. Renseignez les paramètres [OBLIGATOIRE] ci-dessous.
# 3. Lancez le déploiement automatisé :
#      PowerShell : .\scripts\Deploy-ArcIA.ps1
#      Bash/Linux : ./scripts/deploy-arcia.sh
# ==============================================================================

# Sessions agentiques WebUI : Kubernetes, un pod/PVC privé par compte.
# Aucun repli vers le runtime partagé. Les power users réutilisent leur pod.
# Les vrais identifiants et références restent dans le dépôt d'instance privé.
hermes_workspaces:
  users: []
  # - webui_user_id: "identifiant-stable-fourni-par-open-webui"
  #   inference_secret: "litellm-utilisateur-synthetique"
  # - webui_user_id: "identifiant-stable-d-un-power-user"
  #   poweruser_slug: "expert-synthetique"
  # Le Secret nominatif doit déjà exister avec la clé `virtual-key`.

# ==============================================================================
# 1. CONNEXION KUBERNETES [OBLIGATOIRE]
# ==============================================================================
kubernetes:
  # Mode d'exécution de kubectl :
  # - 'local' : utilise la commande 'kubectl' locale (contexte Kubeconfig actif)
  # - 'remote-ssh' : exécute kubectl à distance sur un nœud via SSH (ex: cluster K3s)
  mode: "local"

  # [OBLIGATOIRE si mode: local] Contexte ou chemin vers le Kubeconfig
  # Laisser vide ("") ou null pour utiliser la configuration active (~/.kube/config)
  kubeconfig: ""

  # Contexte Kubernetes à utiliser (laisser vide pour le contexte courant)
  context: ""

  # Namespace Kubernetes cible où déployer la suite applicative ArcIA
  # Le namespace sera créé automatiquement s'il n'existe pas.
  namespace: "arcia"

  # StorageClass pour l'allocation des volumes persistants PVC (Hermes, Open-WebUI, LiteLLM DB) :
  # - Laisser vide ("") ou null : utilise la StorageClass par DÉFAUT du cluster
  #   (recommandé pour EKS 'gp3', GKE 'standard', AKS 'managed-csi', K3s 'local-path', etc.)
  # - Ou spécifier explicitement le nom de votre StorageClass
  storage_class: ""

  # [OBLIGATOIRE UNIQUEMENT si mode: remote-ssh] Paramètres d'accès SSH au nœud maître
  remote_ssh:
    node_ip: "127.0.0.1"
    ssh_user: "debian"
    ssh_port: 22
    # Chemin vers votre clé privée SSH (ex: ~/.ssh/id_rsa, ~/.ssh/id_ed25519 ou key.pem).
    # Laisser vide ("") pour utiliser l'agent SSH local ou la variable ARCIA_SSH_KEY.
    ssh_key: ""

# ==============================================================================
# 2. EXPOSITION RESEAU, DOMAINE FQDN & CERTIFICAT TLS [OBLIGATOIRE]
# ==============================================================================
network:
  # [OBLIGATOIRE] Nom de domaine public complet (FQDN) de votre instance ArcIA
  # Vos utilisateurs accéderont à l'interface via : https://<public_fqdn>/
  # Exemples : "assistant.mon-entreprise.com", "arcia.domaine.fr"
  public_fqdn: "assistant.example.org"

  # Classe du contrôleur Ingress du cluster :
  # - "traefik" : Traefik Ingress (standard K3s et Helm)
  # - "nginx" : Ingress NGINX (ingress-nginx)
  # - "default" : Utilise l'IngressClass par défaut du cluster
  ingress_class: "traefik"

  # Gestion des certificats TLS / HTTPS :
  # - "letsencrypt-prod" : Émission et renouvellement automatique Let's Encrypt (recommandé en prod)
  # - "letsencrypt-staging" : Environnement de test Let's Encrypt (évite le rate-limiting)
  # - "custom-secret" : Utilise un secret TLS existant déjà présent dans le cluster
  # - "disabled" : Pas de TLS (HTTP port 80 direct - déconseillé hors lab)
  tls_mode: "letsencrypt-prod"

  # [OBLIGATOIRE si tls_mode: letsencrypt-*] Email de contact pour les renouvellements ACME
  acme_email: "admin@example.org"

  # Nom du secret Kubernetes contenant le certificat TLS
  # - Si letsencrypt : 'arcia-tls-cert' est généré automatiquement par Cert-Manager
  # - Si custom-secret : nom de votre secret existant dans le namespace
  tls_secret_name: "arcia-tls-cert"

# ==============================================================================
# 3. COMPATIBILITÉ HISTORIQUE LITELLM — MIGRATION UNIQUEMENT
# ==============================================================================
llm_gateway:
  # Conservé pour restaurer/recetter l'ancien transport. Ces clés et tables ne
  # configurent pas agentgateway. Le contrat cible ne possède pas de category.
  # [OBLIGATOIRE] Clé d'API du fournisseur d'inférence Cloud (OpenRouter)
  # Obtenez votre clé sur : https://openrouter.ai/
  openrouter_api_key: "sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

  # Clé maître de la passerelle LiteLLM (pour administrer les clés virtuelles et budgets)
  # Vide : préserver le Secret existant, ou générer une clé sk-arcia-* à l'installation.
  master_key: ""
  salt_key: ""
  db_password: ""

  # Fournisseurs directs optionnels (injectés dans litellm-secret et le pod).
  openai_api_key: ""
  anthropic_api_key: ""
  mistral_api_key: ""
  gemini_api_key: ""

  # Exemple de catalogue explicite : les noms sont libres.
  # La catégorie Simple relie Open-WebUI à LiteLLM ; Agentic passe par Hermes.
  # Adaptez modèles et fournisseurs aux souscriptions de votre instance.
  models_routing:
    - alias: "conversation"
      category: "simple"
      provider: "openrouter"
      target_model: "openrouter/auto"
      zdr: true
    - alias: "mission"
      category: "agentic"
      provider: "openrouter"
      target_model: "openrouter/auto"
      zdr: true
  default_model: "conversation"

  # [OPTIONNEL] Serveur d'inférence LLM local souverain (ex: vLLM on-premise sur GPU interne)
  local_vllm_endpoint: ""

# ==============================================================================
# 4. MOTEUR D'AGENTS HERMES & STUDIO KANBAN [OBLIGATOIRE]
# ==============================================================================
hermes:
  default_model: "mission"
  # [OBLIGATOIRE] Mot de passe administrateur du Studio Kanban (:9119)
  # Identifiant web par défaut : admin
  admin_password: "ChangeThisToAStrongPassword2026!"

  # [OBLIGATOIRE] Jeton d'API (Personal Access Token PAT) pour le client lourd Hermes Desktop (:8642)
  api_token: "arcia-pat-secret-key-32b-secure"

  # Espace de stockage alloué pour le dossier de travail persistant de l'agent
  storage_size: "20Gi"

# ==============================================================================
# 5. BOUCLIER DE CONFIDENTIALITE PRESIDIO DLP [OBLIGATOIRE]
# ==============================================================================
presidio:
  # Active le microservice de caviardage DLP en coupure (fail-closed)
  # Masque automatiquement adresses IP, emails, téléphones, IBAN, cartes, mots de passe et secrets
  enabled: true

  # Clé maître interne de hachage Presidio
  master_key: "arcia-presidio-master-secret-key"

# ==============================================================================
# 6. PORTAIL COLLABORATEUR OPEN-WEBUI [OBLIGATOIRE]
# ==============================================================================
open_webui:
  # Déploie l'interface conversationnelle moderne pour l'ensemble des collaborateurs
  enabled: true

  # Espace de stockage pour les profils, historiques de conversations et documents RAG
  storage_size: "20Gi"

# ==============================================================================
# 7. AUTHENTIFICATION SSO MICROSOFT ENTRA ID (ZERO-TRUST) [OPTIONNEL]
# ==============================================================================
# Déploie oauth2-proxy et le middleware Traefik ForwardAuth pour restreindre l'accès
# à Hermes Studio (/studio) et la Gateway Desktop (/gateway) aux comptes Microsoft 365 de votre entreprise.
entra_id_sso:
  enabled: false

  # [Requis si enabled: true] Identifiants de l'App Registration Microsoft Entra ID
  tenant_id: "00000000-0000-0000-0000-000000000000"
  client_id: "00000000-0000-0000-0000-000000000000"
  client_secret: "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

  # Secret de chiffrement des cookies de session pour oauth2-proxy (16, 24 ou 32 octets)
  cookie_secret: "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ==============================================================================
# 8. ADAPTATEUR MICROSOFT TEAMS BOT [OPTIONNEL]
# ==============================================================================
teams_bot:
  enabled: false

  # [Requis si enabled: true] Identifiants Azure Bot Service
  app_id: "00000000-0000-0000-0000-000000000000"
  app_password: "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

  # [Optionnel] Tenant ID (GUID) requis si le bot Azure a été créé en mode 'Single Tenant'
  # Si omis, le bot fonctionne en mode 'Multi Tenant' (ou hérite de entra_id_sso.tenant_id si actif).
  tenant_id: ""

  # Prompt système injecté pour personnaliser le comportement du Bot Teams
  system_prompt: "Tu es ArcIA, l'assistant et orchestrateur agentique d'entreprise. Réponds de façon synthétique, professionnelle et structurée en Markdown."

# ==============================================================================
# 9. INTEGRATION MICROSOFT 365 AVANCEE (GRAPH / SHAREPOINT) [OPTIONNEL]
# ==============================================================================
microsoft365_integration:
  enabled: false
  config_file: "instance/microsoft365.yaml"


# Dépôt privé d'instance ; jamais le dépôt du harness générique.
# Étape dédiée Dépôt d'instance et reprise, puis menu Sauvegarde et reprise.
# Conserver le mot de passe maître séparément ; jamais dans ce fichier.
# YAML entier, environnements et fichiers de configuration référencés sont chiffrés.
# Les admins maintiennent code/skills/MCP maison et sauvegardes des données.
instance_backup:
  enabled: true
  repo_url: ""
  # Fichiers locaux supplémentaires à embarquer (pas de répertoire ni de coffre).
  additional_files: []
# Option visuelle par entrée llm_gateway.models_routing :
# hosting: "local" ou "cloud" (absent : type du fournisseur).
# Ce champ de présentation ne change aucune politique DLP ou ZDR.
