            "personal"
          ]
        },
        "resource_specific_permissions": {
          "const": []
        },
        "pilot_group_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "publication_verified": {
          "type": "boolean"
        }
      }
    },
    "meetings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "authorization",
        "application_access_policy_name",
        "organizer_object_ids",
        "transcription_policy_name",
        "transcription_verified",
        "graph_transcript_access_verified",
        "speaker_attribution",
        "trigger",
        "polling_interval_seconds",
        "transcript_format",
        "summary_delivery",
        "recordings_enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "authorization": {
          "const": "organizer_policy"
        },
        "application_access_policy_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]{1,100}$"
        },
        "organizer_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "transcription_policy_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]{1,100}$"
        },
        "transcription_verified": {
          "type": "boolean"
        },
        "graph_transcript_access_verified": {
          "type": "boolean"
        },
        "speaker_attribution": {
          "enum": [
            "unknown",
            "allowed",
            "disabled"
          ]
        },
        "trigger": {
          "enum": [
            "registered_meetings_polling",
            "organizer_webhooks"
          ]
        },
        "polling_interval_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "transcript_format": {
          "enum": [
            "text/vtt",
            "application/vnd.microsoft.graph.transcript+text"
          ]
        },
        "summary_delivery": {
          "const": "personal_private_link"
        },
        "recordings_enabled": {
          "type": "boolean"
        }
      }
    },
    "sharepoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "authorization",
        "sites",
        "fail_closed_on_unknown_acl"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "authorization": {
          "const": "application_selected"
        },
        "sites": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "site_id",
              "permission_id",
              "role",
              "drive_ids",
              "audience_group_ids",
              "acl_mode",
              "grant_verified"
            ],
            "properties": {
              "site_id": {
                "type": "string",
                "pattern": "^[a-z0-9.-]+,[0-9a-fA-F-]{36},[0-9a-fA-F-]{36}$"
              },
              "permission_id": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "const": "read"
              },
              "drive_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "audience_group_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "acl_mode": {
                "const": "dedicated_library_uniform"
              },
              "grant_verified": {
                "type": "boolean"
              }
            }
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "fail_closed_on_unknown_acl": {
          "const": true
        }
      }
    },
    "outlook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delegated_enabled",
        "application_enabled",
        "authorization",
        "pilot_group_id",
        "exchange_management_scope_name",
        "exchange_role_assignment_names",
        "exchange_roles",
        "mailbox_object_ids",
        "scope_verified",
        "outside_scope_denied_verified",
        "writes_enabled"
      ],
      "properties": {
        "delegated_enabled": {
          "type": "boolean"
        },
        "application_enabled": {
          "type": "boolean"
        },
        "authorization": {
          "const": "exchange_rbac"
        },
        "pilot_group_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "exchange_management_scope_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]{1,100}$"
        },
        "exchange_role_assignment_names": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "exchange_roles": {
          "const": [
            "Application Mail.Read",
            "Application Calendars.Read"
          ]
        },
        "mailbox_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "scope_verified": {
          "type": "boolean"
        },
        "outside_scope_denied_verified": {
          "type": "boolean"
        },
        "writes_enabled": {
          "type": "boolean"
        }
      }
    },
    "webhooks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "include_resource_data",
        "client_state_reference",
        "encryption_private_key_reference",
        "encryption_certificate_id"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "include_resource_data": {
          "const": false
        },
        "client_state_reference": {
          "const": "secretref://m365/webhook-client-state"
        },
        "encryption_private_key_reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^secretref://m365/[a-z0-9-]+$"
        },
        "encryption_certificate_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]{1,100}$"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic_only",
        "risky_actions_require_server_approval",
        "raw_private_data_to_cloud",
        "runtime_qualification_verified",
        "retention_days",
        "evidence_reference"
      ],
      "properties": {
        "synthetic_only": {
          "const": true
        },
        "risky_actions_require_server_approval": {
          "const": true
        },
        "raw_private_data_to_cloud": {
          "const": false
        },
        "runtime_qualification_verified": {
          "type": "boolean"
        },
        "retention_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 3650
        },
        "evidence_reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "^evidence://m365/[a-z0-9-]+$"
        }
      }
    }
  }
}
