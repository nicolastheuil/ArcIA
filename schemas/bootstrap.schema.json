{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:arcia:harness:bootstrap:1",
  "title": "ArcIA bootstrap configuration (private outside synthetic fixtures)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "synthetic",
    "github",
    "nodes",
    "network",
    "storage",
    "gates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account",
        "repository",
        "visibility"
      ],
      "properties": {
        "account": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        "visibility": {
          "const": "private"
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "address",
          "ssh_user",
          "ssh_port",
          "identity_file",
          "known_hosts_file"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "address": {
            "type": "string",
            "format": "ipv4"
          },
          "ssh_user": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
          },
          "ssh_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "identity_file": {
            "type": "string",
            "minLength": 1
          },
          "known_hosts_file": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_endpoint",
        "public_hostname",
        "pod_cidr",
        "service_cidr",
        "existing_cidrs",
        "existing_cidrs_reviewed"
      ],
      "properties": {
        "api_endpoint": {
          "type": "string",
          "minLength": 1
        },
        "public_hostname": {
          "type": "string",
          "minLength": 1
        },
        "pod_cidr": {
          "type": "string",
          "minLength": 1
        },
        "service_cidr": {
          "type": "string",
          "minLength": 1
        },
        "existing_cidrs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "existing_cidrs_reviewed": {
          "type": "boolean"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_class",
        "policy_ref"
      ],
      "properties": {
        "storage_class": {
          "type": "string",
          "minLength": 1
        },
        "policy_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vmware_compatibility",
        "api_failover",
        "network_review",
        "cpi_design"
      ],
      "properties": {
        "vmware_compatibility": {
          "enum": [
            "pending",
            "verified"
          ]
        },
        "api_failover": {
          "enum": [
            "pending",
            "verified"
          ]
        },
        "network_review": {
          "enum": [
            "pending",
            "verified"
          ]
        },
        "cpi_design": {
          "enum": [
            "pending",
            "verified"
          ]
        }
      }
    }
  }
}
